# The demo and tests need no credentials. Copy to .env for optional services.
RESOLVE_DATA_DIR=data
RESOLVE_RUNTIME_DIR=runtime
RESOLVE_MODEL_MODE=rules
# Set to compatible to use Nemotron or another OpenAI-compatible endpoint.
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_API_KEY=
# Copy the model identifier from your provider; there is no hardcoded model.
MODEL_NAME=nvidia/nemotron-3-super-120b-a12b
MODEL_TIMEOUT_SECONDS=60

# Research backend: local (SQLite fallback, default) or zetaris (federated query).
RESOLVE_RESEARCH=local
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
# Create in the Zetaris UI: Management, then API Tokens. Shown once.
ZETARIS_API_KEY=

# Meterless engine logs (World Model, H-MEM audit) and H-MEM memory tiers.
RESOLVE_LOG_DIR=logs
RESOLVE_MEMORY_DIR=runtime/memory

# External actions require BOTH --live and RESOLVE_ALLOW_LIVE_ACTIONS=true.
RESOLVE_ALLOW_LIVE_ACTIONS=false
GITHUB_TOKEN=
GITHUB_REPOSITORY=resolve-hackathon/cloudnest
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_SUPPORT_CHANNEL_ID=
DISCORD_ESCALATION_CHANNEL_ID=
