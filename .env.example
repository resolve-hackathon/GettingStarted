# The demo and tests need no credentials. Copy to .env for optional services.
RESOLVE_DATA_DIR=data
RESOLVE_RUNTIME_DIR=runtime
# true: no Zetaris, Nightshift, network or credentials (offline rules, local data, dry run).
SAMPLE_MODE=false
# rules (offline baseline) or nightshift (Meterless Nightshift, the primary AI provider).
RESOLVE_MODEL_MODE=rules
MODEL_TIMEOUT_SECONDS=120

# Meterless Nightshift, from Nightshift's Console. The NVIDIA key lives in
# Nightshift's Providers tab, never here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Ask Nemotron to answer without extended thinking (enable_thinking=false) and cap output: about 2 s per call.
MODEL_NO_THINK=true
MODEL_MAX_TOKENS=2048

# Research backend: local (SQLite fallback, default) or zetaris (federated query).
RESOLVE_RESEARCH=local
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
# Create in the Zetaris UI: Management, then API Tokens. Shown once.
ZETARIS_API_KEY=

# Meterless engine logs (World Model, H-MEM audit) and H-MEM memory tiers.
RESOLVE_LOG_DIR=logs
RESOLVE_MEMORY_DIR=runtime/memory

# External actions require BOTH --live and RESOLVE_ALLOW_LIVE_ACTIONS=true.
RESOLVE_ALLOW_LIVE_ACTIONS=false
GITHUB_TOKEN=
GITHUB_REPOSITORY=resolve-hackathon/cloudnest
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_SUPPORT_CHANNEL_ID=
DISCORD_ESCALATION_CHANNEL_ID=
