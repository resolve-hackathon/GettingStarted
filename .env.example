# The demo and tests need no credentials. Copy to .env for optional services.
RESOLVE_DATA_DIR=data
RESOLVE_RUNTIME_DIR=runtime
RESOLVE_MODEL_MODE=rules
# Set to compatible to use Nemotron or another OpenAI-compatible endpoint.
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_API_KEY=
# Copy the model identifier from your provider; there is no hardcoded model.
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=20

# Local SQLite fallback is implemented. Zetaris requires your tenant connection;
# see docs/INTEGRATIONS.md and resolve/research.py before changing the researcher.

# External actions require BOTH --live and RESOLVE_ALLOW_LIVE_ACTIONS=true.
RESOLVE_ALLOW_LIVE_ACTIONS=false
GITHUB_TOKEN=
GITHUB_REPOSITORY=resolve-hackathon/resolve-agent
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_SUPPORT_CHANNEL_ID=
DISCORD_ESCALATION_CHANNEL_ID=
